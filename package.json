{
  "name": "ghostguessr",
  "version": "3.0.0",
  "description": "Ghost marker, score predictor and more for GeoGuessr on Web and Steam.",
  "private": false,
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "serve": "webpack serve --mode development --open",
    "preview": "webpack --mode development && node scripts/preview-server.js",
    "patcher:dev": "cd src/patcher && pnpm dev",
    "patcher:build": "cd src/patcher && pnpm build",
    "patcher:test": "cd src/patcher/src-tauri && cargo test",
    "build:all": "pnpm build && pnpm patcher:build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JojocraftTv/GhostGuessr"
  },
  "keywords": [
    "geoguessr",
    "userscript",
    "tampermonkey"
  ],
  "author": "VellusFox, Niceas",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "babel-loader": "^9.1.0",
    "copy-webpack-plugin": "^12.0.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^4.15.0",
    "webpack-userscript": "^3.2.0"
  }
}
